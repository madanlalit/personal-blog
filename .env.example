# PostHog Analytics Configuration
# Get your Project API Key from https://us.posthog.com/settings/project
NEXT_PUBLIC_POSTHOG_KEY=phc_your_posthog_project_api_key_here

# Optional: Host URL.
# In local dev (npm run dev), defaults to https://us.i.posthog.com
# In production on Cloudflare Pages, defaults to /ingest (routed through Cloudflare Pages reverse proxy)
NEXT_PUBLIC_POSTHOG_HOST=/ingest
